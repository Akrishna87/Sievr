<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the user's own file goes to backups and device transfers; market data is re-downloaded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="user.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="user.json" />
    </device-transfer>
</data-extraction-rules>
